!package.json
!package-lock.json
!frontend/package.json
!shared/
!server/
!ai/package.json
!ai/package-lock.json
!ai/build.mjs
!ai/procedure.md
!ai/nvidia-key.enc
!ai/tools/
!ai/pi/
!frontend/src/books/
!frontend/src/lib/format.ts
!frontend/src/features/reader/dom.ts
!frontend/src/features/reader/search.ts
**/node_modules
server/dist
server/.env
