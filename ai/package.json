{
  "name": "@breader/ai",
  "private": true,
  "type": "module",
  "description": "Offline tools for the Antigravity procedure (procedure.md): fetch books, extract them the way the reader does, check and pack the notes and voice marks.",
  "scripts": {
    "books": "tsx tools/cli/books.ts",
    "fetch": "tsx tools/cli/fetch.ts",
    "check": "tsx tools/cli/check.ts",
    "mark": "tsx tools/cli/mark.ts",
    "mark-all": "tsx tools/cli/mark-all.ts",
    "notes": "tsx tools/cli/notes.ts",
    "research": "tsx tools/cli/research.ts",
    "music": "tsx tools/cli/music.ts",
    "pipeline": "tsx tools/cli/pipeline.ts",
    "audit": "tsx tools/cli/audit.ts",
    "pack": "tsx tools/cli/pack.ts",
    "import": "tsx tools/cli/import.ts",
    "marker": "tsx tools/cli/marker.ts",
    "seal": "tsx tools/cli/seal.ts",
    "selftest": "tsx tools/cli/selftest.ts",
    "typecheck": "tsc -p .",
    "test": "tsx --test tools/test/*.test.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "@mozilla/readability": "0.6.0",
    "jsdom": "^30.1.1",
    "partial-json": "0.1.7",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "tsx": "^4.23.15"
  }
}
