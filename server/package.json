{
  "name": "@breader/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/api.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "build": "node build.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@breader/shared": "*",
    "@breezystack/lamejs": "1.2.7",
    "@hono/node-server": "^2.1.1",
    "@redis/client": "^6.3.0",
    "age-encryption": "^0.3.1",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "onnxruntime-web": "1.30.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^5.0.2"
  }
}
