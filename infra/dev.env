# Local development only. Every value here is a throwaway test value for the Docker stack in
# compose.dev.yml; production values live in infra/.env (never committed), see .env.example.
NODE_ENV=development
LOG_LEVEL=debug
# a.localhost and b.localhost act as two separate browsers when testing sync on one machine.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://a.localhost:5173,http://b.localhost:5173
COOKIE_SECURE=false
KEY_PEPPER=a6096198ed2e56c581407d266e0699a8e8b3ed0ebe374a9ae953328714e2fd10
SESSION_SECRET=622f7269212f0b82da4658fb28be0e78fcbff79752c6452e41e857f59b562072
# The status page: http://localhost:8787/admin (the laptop) and :8788/admin (the fallback).
ADMIN_TOKEN=dev-admin-6c0f3a9e2b7d41e58a1f9c3b0d6e2a47

# Stand-ins: "primary" plays Supabase, "s3" (RustFS) plays Cloudflare R2.
PRIMARY_URL=postgres://postgres:postgres@primary:5432/breader
S3_ENDPOINT=http://s3:9000
S3_REGION=auto
S3_BUCKET=breader-files
S3_BACKUP_BUCKET=breader-backups
S3_ACCESS_KEY_ID=breader-dev
S3_SECRET_ACCESS_KEY=a926306077ab3441017b483a3abb2c4a
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKETS=true
# Read by the s3 container itself.
RUSTFS_ACCESS_KEY=breader-dev
RUSTFS_SECRET_KEY=a926306077ab3441017b483a3abb2c4a
