# Settings for infra/ship.sh. Copy to infra/.env.ship, fill in, then chmod 600 infra/.env.ship.

# The primary database (the one writer), through a session connection, for migrations. Same as
# PRIMARY_SESSION_URL in infra/.env. PRIMARY_MIGRATE_SSL: require (default) or off.
PRIMARY_MIGRATE_URL=
PRIMARY_MIGRATE_SSL=require
# Deploy hooks of servers that pull the new image when told to, comma-separated. Leave out a
# server that updates itself (the laptop, infra/update.sh). Read copies need nothing here: each
# server migrates its own as it starts.
DEPLOY_HOOKS=

# Built into the app: every server, comma-separated, the home server first (the one with the
# voices and the panel model). The app times each and picks (frontend/src/lib/servers.ts).
VITE_API_SERVERS=https://api.breader.site,https://fb.breader.site
# Asked only while home is away, so they can sleep (Azure).
VITE_API_STANDBY=https://az1.breader.site
# Readers' next chapters in the storage pool (ADR 0003, ADR 0004): the app reads them from here first.
VITE_PAGES_URL=https://pages.breader.site
VITE_SENTRY_DSN=
