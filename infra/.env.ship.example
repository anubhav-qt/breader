# Settings for infra/ship.sh. Copy to infra/.env.ship, fill in, then chmod 600 infra/.env.ship.

# Supabase › Connect › Session pooler (port 5432), for migrations. Same as PRIMARY_SESSION_URL in infra/.env.
SUPABASE_SESSION_URL=
# Render › breader-fallback › Settings › Deploy Hook.
RENDER_DEPLOY_HOOK=

# Built into the app, as Pages had them.
VITE_API_URL=https://api.breader.site
VITE_API_FALLBACK_URL=https://fb.breader.site
VITE_SENTRY_DSN=
