# Production settings for the laptop (compose.yml). Copy to infra/.env, fill in, then
#   chmod 600 infra/.env
# Keep a copy in your password manager. Render gets a subset (README.md › Render).
# breader.example stands in for the real domain throughout.

# The server image CI publishes (lowercase owner).
IMAGE=ghcr.io/your-github-user/breader-server:latest

NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://breader.example
# The parent domain, so api. (laptop) and fb. (Render) share the reader's session.
COOKIE_DOMAIN=breader.example
COOKIE_SECURE=true

# Make each with: openssl rand -base64 48
# Render needs the same two values. Changing KEY_PEPPER makes every library key stop working;
# changing SESSION_SECRET signs every reader out.
KEY_PEPPER=
SESSION_SECRET=

# Supabase › Connect. Transaction pooler (port 6543) for the API:
PRIMARY_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) for the worker and migrations:
PRIMARY_SESSION_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PRIMARY_SSL=require

# The laptop's copy (the mirror container). Letters and digits only: openssl rand -hex 24
MIRROR_PASSWORD=

# Cloudflare R2 › API token with Object Read & Write on both buckets.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=breader-files
S3_BACKUP_BUCKET=breader-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# The public half of your backup key (age1…). The private half never goes on the laptop.
BACKUP_RECIPIENT=
# Heartbeat monitor URL; the worker pings it every 5 minutes while the copy is current.
HEARTBEAT_URL=

# Opens the status page at https://api.breader.example/admin. Make it with: openssl rand -hex 32
# Render takes the same value.
ADMIN_TOKEN=
# Sentry › Project settings › Client keys (DSN). Errors from the API and the worker go there.
SENTRY_DSN=

# Logins (README.md › 5. Secrets › Logins). This server's own address: Google sends readers
# back to it. Render uses https://fb.breader.example.
PUBLIC_URL=https://api.breader.example
# Google Auth Platform › Clients › your web client. Leave both empty to offer email only.
# Render takes the same values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend › API keys (sending access). Without it, account emails are only logged.
# Render takes the same value. MAIL_FROM defaults to Breader <hello@breader.site>.
RESEND_API_KEY=
# MAIL_FROM=Breader <hello@breader.example>

# Cloudflare Zero Trust › Networks › Tunnels › your tunnel › the token in its install command.
TUNNEL_TOKEN=
