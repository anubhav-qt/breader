# One Azure server's settings (deploy.sh, ADR 0004): infra/azure/.env.<name>
# (copy this to .env.sg for deploy.sh sg). Never commit them. deploy.sh keeps every value
# as a Container Apps secret.

IMAGE=ghcr.io/OWNER/breader-server:latest
NODE_ENV=production
ROLE=fallback
MACHINE=azure-<name>

# Supabase Mumbai, the only writer: its transaction pooler, as on Render.
PRIMARY_URL=<transaction pooler URL>
PRIMARY_SSL=require

# A read copy near this region (optional): any Postgres. The API migrates and feeds it; the
# ThinkPad (or GCP's standby) feeds it too while this server sleeps. Its URL in their COPY_URLS
# must match this one's user, host and database.
# COPY_URL=
# COPY_SSL=require

# The same on every server.
KEY_PEPPER=<same>
SESSION_SECRET=<same>
ADMIN_TOKEN=<same>
ALLOWED_ORIGINS=https://breader.example
COOKIE_DOMAIN=breader.example
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=<same>
GOOGLE_CLIENT_SECRET=<same>
RESEND_API_KEY=<same>
SENTRY_DSN=<the DSN>

# This server's own address, DNS only in Cloudflare (Google sends readers back here; add it to the
# OAuth client). Azure's ingress puts the reader's address in X-Forwarded-For.
PUBLIC_URL=https://az1.breader.example
CLIENT_IP_HEADER=x-forwarded-for

# The files bucket, as on Render: its token for that bucket only.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=breader-files
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The storage pool, and this server puts the chapters its readers fetch in it, where there's room.
POOL_MEMBERS=r2,b2,tigris,fastly
POOL_UPLOADS=true
# POOL_<NAME>_ENDPOINT, _REGION, _BUCKET, _KEY_ID, _SECRET, _PUBLIC_URL, _MB (and _WRITES) for
# each, the same as on the ThinkPad.

# Manga: Suwayomi's sources through the one on AWS, as on Render.
SUWAYOMI_URL=https://breader:<password>@sw.breader.example

# The voices and panels: Modal on call (infra/modal), with its token. Leave both out to have none.
ENGINE_FALLBACK_URLS=https://<workspace>--breader-engine-engine.modal.run
ENGINE_TOKEN=<same as Modal's>
SPEECH_CACHE_MB=256

# Busy (lib/busy.ts): the event loop's delay, p95 over 10 s, above this many ms. Off unless set.
# BUSY_LAG_MS=

NODE_OPTIONS=--max-old-space-size=384
MALLOC_ARENA_MAX=2
