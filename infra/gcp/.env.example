# The GCP server's settings (compose.yml, ADR 0004). Copy to infra/gcp/.env; never commit it.
# compose.yml sets ROLE, MACHINE, JSON_ONLY, manga off, the egress count, the copy and the memory
# itself. No manga, Suwayomi, pool or engine here: it answers API calls alone (ADR 0004).

IMAGE=ghcr.io/OWNER/breader-server:latest
NODE_ENV=production

# Supabase Mumbai, the only writer. Its direct host: the poolers have no IPv6, and this machine has
# no IPv4 of its own. A real session, so the standby can hold its feed's long transactions.
PRIMARY_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
PRIMARY_SSL=require

# This server's read copy, on this machine (compose.yml).
COPY_PASSWORD=<a long random password>

# Every other read copy the standby feeds while the ThinkPad is quiet: the same URLs as the
# ThinkPad's COPY_URLS, each with the same user, host and database as its own server's COPY_URL
# (that's its name in feed_copies). This machine's own copy is fed by its API, so it isn't here.
# COPY_SSL applies to each.
COPY_URLS=
COPY_SSL=require
STANDBY_FOR=laptop

# The same on every server.
KEY_PEPPER=<same>
SESSION_SECRET=<same>
ADMIN_TOKEN=<same>
ALLOWED_ORIGINS=https://breader.example
COOKIE_DOMAIN=breader.example
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=<same>
GOOGLE_CLIENT_SECRET=<same>
RESEND_API_KEY=<same>
SENTRY_DSN=<the DSN>

# This server's own address (Google sends readers back here; add it to the OAuth client).
PUBLIC_URL=https://gcp.breader.example

# The files bucket, as on Render: its token for that bucket only.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=breader-files
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The owner's limit on this month's egress, in MB: near it, /health says so, the app stops using
# this server and the standby stops feeding. GCP's free egress is 1 GB a month.
GCP_EGRESS_LIMIT_MB=800
# The machine's network card, whose sent bytes are counted (check with `ip link`).
EGRESS_CARD=ens4

# Busy (lib/busy.ts): the event loop's delay, p95 over 10 s, above this many ms. Off unless set.
# BUSY_LAG_MS=
