# Copy to infra/aws/.env on the AWS machine. It's never committed.

# The tunnel's token: Cloudflare › Zero Trust › Networks › Tunnels › breader-sw › its install command.
TUNNEL_TOKEN=

# Suwayomi's password, for the user breader. Letters and digits only (openssl rand -hex 24), as it
# goes in Render's SUWAYOMI_URL too: https://breader:<password>@sw.breader.example
SUWAYOMI_PASSWORD=
